{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist/web",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://production-teger-scout.tyzo.nodeops.app/api/:path*" },
    { "source": "/fixtures/:path*", "destination": "https://production-teger-scout.tyzo.nodeops.app/fixtures/:path*" },
    { "source": "/((?!assets/|favicon\\.svg$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/((?!api/|fixtures/).*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
