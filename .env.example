# Copy to .env for local development. Placeholders only; never commit real values.

# CreateOS Sandbox API (inspection VMs). Region URL supplied by the organizers.
CREATEOS_SANDBOX_API_KEY=
CREATEOS_SANDBOX_BASE_URL=https://api-eu.sb.createos.sh
TEGER_SANDBOX_ROOTFS=desktop:1
TEGER_SANDBOX_SHAPE=s-1vcpu-1gb

# Model used by the eve inspection agent (agent/agent.ts).
# anthropic | openai | openai-compatible | gateway
TEGER_MODEL_PROVIDER=openai-compatible
TEGER_MODEL_ID=
# For openai-compatible (e.g. OpenRouter provisioned through Stripe Projects):
TEGER_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEGER_MODEL_API_KEY=
# For direct providers instead:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# eve agent server (loopback). scripts/start.mjs generates a random password per boot if unset.
EVE_HOST=http://127.0.0.1:3101
EVE_INTERNAL_PASSWORD=

# App
PORT=8080
TEGER_PUBLIC_URL=
TEGER_DATA_DIR=./data
TEGER_SESSION_SECRET=
# Live scans are open by default. Set TEGER_REQUIRE_ACCESS_CODE=1 to require the code below.
TEGER_REQUIRE_ACCESS_CODE=0
TEGER_LIVE_ACCESS_CODE=
# Optional pilot allowlist of registrable domains (comma separated). Empty = any public host.
TEGER_PILOT_DOMAINS=

# Limits
TEGER_MAX_ATTEMPTS=3
TEGER_SCAN_DEADLINE_MS=300000
TEGER_SCRIPT_TIMEOUT_SEC=60
TEGER_DAILY_LIVE_SCANS=8
TEGER_SESSION_HOURLY_SCANS=4
